+"""Metadata-only compatibility copy for the pinned Elephant-1 decision GGUF."""
+import hashlib
+import json
+import os
+import shutil
+import struct
+from pathlib import Path
+
+ELEPHANT_SHA256 = "5bc2a8f7c707da1680b49a3984a762478733f894eb38c9b4d07babf2f0004b6a"
+HEADER_BYTES = 65536
+
+
+def _patches(header: bytes) -> list[tuple[int, bytes, bytes]]:
+    if header[:4] != b"GGUF" or struct.unpack_from("<I", header, 4)[0] != 3:
+        raise RuntimeError("Elephant compatibility requires the pinned little-endian GGUF v3")
+    patches = []
+    for key, old, new in ((b"qwen35.block_count", 33, 32), (b"qwen35.nextn_predict_layers", 1, 0)):
+        prefix = struct.pack("<Q", len(key)) + key + struct.pack("<I", 4)  # UINT32
+        pattern = prefix + struct.pack("<I", old)
+        offset = header.find(pattern)
+        if offset < 0 or header.find(pattern, offset + 1) >= 0:
+            raise RuntimeError("Pinned Elephant metadata differs from the inspected layout")
+        patches.append((offset + len(prefix), struct.pack("<I", old), struct.pack("<I", new)))
+    key = b"qwen35.attention.recurrent_layers"
+    renamed = b"custom.attention.recurrent_layers"
+    pattern = struct.pack("<Q", len(key)) + key + struct.pack("<IIQ", 9, 7, 33)  # ARRAY of BOOL
+    offset = header.find(pattern)
+    if offset < 0 or header.find(pattern, offset + 1) >= 0:
+        raise RuntimeError("Pinned Elephant recurrent-layer metadata was not found uniquely")
+    values = header[offset + len(pattern):offset + len(pattern) + 33]
+    expected = bytes([int((index + 1) % 4 != 0) for index in range(32)] + [0])
+    if values != expected or len(key) != len(renamed):
+        raise RuntimeError("Elephant layer mask does not match the 32-layer trunk")
+    # The loader reconstructs the same 32-entry mask from full_attention_interval=4.
+    # Renaming the obsolete 33-entry key keeps every byte offset unchanged.
+    patches.append((offset + 8, key, renamed))
+    return patches
+
+
+def _verify(path: Path, patches: list[tuple[int, bytes, bytes]]) -> str:
+    original_digest, runtime_digest = hashlib.sha256(), hashlib.sha256()
+    with path.open("rb") as handle:
+        header = handle.read(HEADER_BYTES)
+        runtime_digest.update(header)
+        restored = bytearray(header)
+        for offset, old, new in patches:
+            if restored[offset:offset + len(new)] != new:
+                raise RuntimeError("Incomplete Elephant compatibility copy")
+            restored[offset:offset + len(old)] = old
+        original_digest.update(restored)
+        for chunk in iter(lambda: handle.read(16 << 20), b""):
+            original_digest.update(chunk)
+            runtime_digest.update(chunk)
+    if original_digest.hexdigest() != ELEPHANT_SHA256:
+        raise RuntimeError("Compatibility copy differs outside the intended metadata bytes")
+    return runtime_digest.hexdigest()
+
+
+def elephant_compatible(original: Path, cache: Path, source_sha256: str) -> dict:
+    if source_sha256 != ELEPHANT_SHA256:
+        raise RuntimeError("Elephant compatibility is restricted to the inspected source SHA-256")
+    with original.open("rb") as handle:
+        patches = _patches(handle.read(HEADER_BYTES))
+    cache.mkdir(parents=True, exist_ok=True)
+    target = cache / ("elephant-runtime-" + source_sha256[:16] + ".gguf")
+    if target.exists():
+        runtime_sha256 = _verify(target, patches)
+    else:
+        partial = target.with_suffix(".partial")
+        try:
+            shutil.copyfile(original, partial)
+            with partial.open("r+b") as handle:
+                for offset, old, new in patches:
+                    handle.seek(offset)
+                    if handle.read(len(old)) != old:
+                        raise RuntimeError("Source metadata changed while creating compatibility copy")
+                    handle.seek(offset)
+                    handle.write(new)
+            runtime_sha256 = _verify(partial, patches)
+            os.replace(partial, target)
+        finally:
+            partial.unlink(missing_ok=True)
+    return {"source_sha256": source_sha256, "runtime_sha256": runtime_sha256,
+            "source_file": str(original), "runtime_file": str(target),
+            "original_bytes_verified": True, "tensor_bytes_unchanged": True,
+            "metadata_changes": {"block_count": 32, "nextn_predict_layers": 0,
+                                 "legacy_recurrent_mask": "ignored; same 32-layer mask reconstructed"}}
