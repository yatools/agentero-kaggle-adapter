+"""Use tiny GGUF-like fixtures, never real weights or network requests."""
+import hashlib
+import struct
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "kaggle"))
+import gguf_compat
+
+
+def fixture():
+    data = b"GGUF" + struct.pack("<IQQ", 3, 0, 3)
+    for key, value in ((b"qwen35.block_count", 33), (b"qwen35.nextn_predict_layers", 1)):
+        data += struct.pack("<Q", len(key)) + key + struct.pack("<II", 4, value)
+    key = b"qwen35.attention.recurrent_layers"
+    data += struct.pack("<Q", len(key)) + key + struct.pack("<IIQ", 9, 7, 33)
+    data += bytes([int((index + 1) % 4 != 0) for index in range(32)] + [0])
+    return data + b"synthetic-tensor-bytes" * 40
+
+
+class CompatibilityTests(unittest.TestCase):
+    def test_only_declared_metadata_bytes_change_and_original_is_preserved(self):
+        data = fixture()
+        digest = hashlib.sha256(data).hexdigest()
+        with tempfile.TemporaryDirectory() as folder, patch.object(gguf_compat, "ELEPHANT_SHA256", digest):
+            source = Path(folder) / "source.gguf"
+            source.write_bytes(data)
+            report = gguf_compat.elephant_compatible(source, Path(folder) / "cache", digest)
+            runtime = Path(report["runtime_file"]).read_bytes()
+            self.assertEqual(source.read_bytes(), data)
+            restored = bytearray(runtime)
+            for offset, old, new in gguf_compat._patches(data):
+                self.assertEqual(runtime[offset:offset + len(new)], new)
+                restored[offset:offset + len(old)] = old
+            self.assertEqual(restored, data)
+            self.assertEqual(len(runtime), len(data))
+            self.assertTrue(report["tensor_bytes_unchanged"])
+
+    def test_unknown_source_is_rejected_before_copy(self):
+        with self.assertRaises(RuntimeError):
+            gguf_compat.elephant_compatible(Path("absent.gguf"), Path("unused"), "0" * 64)
+
+    def test_corrupted_cached_copy_is_rejected(self):
+        data = fixture()
+        digest = hashlib.sha256(data).hexdigest()
+        with tempfile.TemporaryDirectory() as folder, patch.object(gguf_compat, "ELEPHANT_SHA256", digest):
+            source = Path(folder) / "source.gguf"
+            source.write_bytes(data)
+            report = gguf_compat.elephant_compatible(source, Path(folder) / "cache", digest)
+            target = Path(report["runtime_file"])
+            target.write_bytes(target.read_bytes()[:-1] + b"!")
+            with self.assertRaises(RuntimeError):
+                gguf_compat.elephant_compatible(source, Path(folder) / "cache", digest)
+
+
+if __name__ == "__main__":
+    unittest.main()
