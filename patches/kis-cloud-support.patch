+"""Dataset integration checks using tiny synthetic files; never run Kaggle jobs."""
+
+import dataclasses
+import hashlib
+import json
+import subprocess
+import sys
+import tempfile
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "kaggle"))
+import common
+import backends
+from kis import kaggle
+from kis.schema import Model
+from kis.settings import parse_config
+
+
+class DatasetStorageTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.root = Path(self.temp.name)
+        self.addCleanup(self.temp.cleanup)
+        self.model = Model(repo="provenance/model", file="model.gguf", alias="test", parallel=1, dataset="owner/model")
+
+    def create_file(self, layout):
+        path = self.root / layout / self.model.file
+        path.parent.mkdir(parents=True)
+        path.write_bytes(b"synthetic-test-data")
+        return path
+
+    def test_reads_both_mount_layouts_and_checks_hash_without_hf(self):
+        for layout in ("model", "datasets/owner/model"):
+            with self.subTest(layout=layout), tempfile.TemporaryDirectory() as folder:
+                root = Path(folder)
+                path = root / layout / self.model.file
+                path.parent.mkdir(parents=True)
+                path.write_bytes(b"synthetic-test-data")
+                digest = hashlib.sha256(path.read_bytes()).hexdigest()
+                with patch.object(common, "INPUT_DIR", root), patch.dict(sys.modules, {"huggingface_hub": None}):
+                    self.assertEqual(common.fetch(self.model, self.model.file, digest), str(path.resolve()))
+
+    def test_missing_dataset_does_not_fall_back_to_a_network_download(self):
+        with patch.object(common, "INPUT_DIR", self.root), patch.dict(sys.modules, {"huggingface_hub": None}):
+            with self.assertRaises(FileNotFoundError):
+                common.fetch(self.model, self.model.file)
+
+    def test_checksum_mismatch_fails(self):
+        self.create_file("model")
+        with patch.object(common, "INPUT_DIR", self.root), self.assertRaisesRegex(RuntimeError, "sha256 mismatch"):
+            common.fetch(self.model, self.model.file, "0" * 64)
+
+    def test_paths_cannot_escape_inputs(self):
+        with patch.object(common, "INPUT_DIR", self.root):
+            for file in ("../outside.gguf", "/outside.gguf", "..\\outside.gguf"):
+                with self.subTest(file=file), self.assertRaises(ValueError):
+                    common.dataset_file("owner/model", file)
+            for dataset in ("../model", "owner/model/extra", ""):
+                with self.subTest(dataset=dataset), self.assertRaises(ValueError):
+                    common.dataset_file(dataset, "model.gguf")
+
+    def test_existing_hugging_face_download_behavior_is_preserved(self):
+        path = self.create_file("downloaded")
+        calls = []
+        module = types.ModuleType("huggingface_hub")
+        module.hf_hub_download = lambda *args, **kwargs: calls.append((args, kwargs)) or str(path)
+        model = dataclasses.replace(self.model, dataset=None, revision="pinned")
+        with patch.dict(sys.modules, {"huggingface_hub": module}):
+            self.assertEqual(common.fetch(model, model.file), str(path))
+        self.assertEqual(calls[0][1]["revision"], "pinned")
+
+    def test_identical_filenames_in_different_sources_are_fetched_separately(self):
+        other = dataclasses.replace(self.model, dataset="owner/other")
+        hf = dataclasses.replace(self.model, dataset=None)
+        compatible = dataclasses.replace(self.model, gguf_compat="elephant-1")
+        with patch.object(backends, "FETCHED", {}), patch.object(backends, "FETCH_LOCKS", {}), \
+                patch.object(backends, "fetch", side_effect=lambda model, file, digest: str((model.dataset, model.gguf_compat))) as fetch:
+            paths = [backends.model_files(model)[0] for model in (self.model, other, hf, compatible)]
+            backends.model_files(self.model)
+        self.assertEqual(len(set(paths)), 4)
+        self.assertEqual(fetch.call_count, 4)
+
+    def test_server_and_calibration_attach_dataset_but_build_does_not(self):
+        config = parse_config({
+            "kaggle": {"username": "tester", "llama_cpp_ref": "pinned"},
+            "models": {"first": dataclasses.asdict(self.model), "second": dataclasses.asdict(self.model)},
+        }, environ={})
+        for script in (kaggle.SERVER_SCRIPT, kaggle.CALIBRATE_SCRIPT, kaggle.BUILD_SCRIPT):
+            slug = script.removesuffix(".py")
+            with patch.object(kaggle, "STATE_DIR", self.root), patch.object(kaggle, "render", return_value="# test"), \
+                    patch.object(kaggle, "_cli", return_value=subprocess.CompletedProcess([], 0, "", "")):
+                kaggle.push(config, slug, script, {})
+            metadata = json.loads((self.root / slug / "kernel-metadata.json").read_text())
+            self.assertEqual(metadata["dataset_sources"], [] if script == kaggle.BUILD_SCRIPT else ["owner/model"])
+
+
+if __name__ == "__main__":
+    unittest.main()
