+"""Decision cancellation across a buffering tunnel, without a model or GPU."""
+
+import asyncio
+import dataclasses
+import uuid
+
+import aiohttp
+import pytest
+from aiohttp import web
+from aiohttp.test_utils import TestServer
+from conftest import SECRETS, FakeBackends, make_balancer
+
+from kis import events, proxy
+
+AUTH = {"Authorization": "Bearer secret"}
+
+
+async def wait_until(predicate):
+    async with asyncio.timeout(3):
+        while not predicate():
+            await asyncio.sleep(0.01)
+
+
+class BufferingServer(TestServer):
+    async def _make_runner(self, **kwargs):
+        kwargs["handler_cancellation"] = False
+        return await super()._make_runner(**kwargs)
+
+
+async def slow_balancer(server, aiohttp_server, aiohttp_client, monkeypatch):
+    began, cancelled = asyncio.Event(), asyncio.Event()
+
+    async def decide(req):
+        await req.read()
+        began.set()
+        try:
+            await asyncio.Event().wait()
+        finally:
+            cancelled.set()
+        return web.json_response({"answers": {}})
+
+    backend_app = web.Application()
+    backend_app.router.add_post("/v1/systemone", decide)
+    backend = await aiohttp_server(backend_app)
+    balancer = make_balancer(server, FakeBackends({server.START: [backend.port]}, server.START))
+    monkeypatch.setattr(balancer, "settings", dataclasses.replace(balancer.settings, session="original-session"))
+    # Deliberately do not cancel this handler just because the tunnel disconnects.
+    cloud = BufferingServer(balancer.app())
+    await aiohttp_client(cloud)
+    return balancer, cloud, began, cancelled
+
+
+async def test_cancel_requires_auth_post_and_original_session(aiohttp_client, balancer):
+    client = await aiohttp_client(balancer.app())
+    request_id = uuid.uuid4().hex
+    query = {"session": balancer.settings.session, "request_id": request_id}
+    assert (await client.post("/admin/cancel", params=query)).status == 401
+    assert (await client.get("/admin/cancel", params=query, headers=AUTH)).status == 405
+    assert (await client.post("/admin/cancel", params={**query, "session": "replacement"}, headers=AUTH)).status == 409
+    assert not balancer.cancelled_ids
+    assert (await client.post("/admin/cancel", params={**query, "request_id": "bad"}, headers=AUTH)).status == 400
+
+
+async def test_cancel_before_arrival_prevents_late_work(aiohttp_client, balancer):
+    client = await aiohttp_client(balancer.app())
+    request_id = uuid.uuid4().hex
+    query = {"session": balancer.settings.session, "request_id": request_id}
+    for _ in range(2):
+        response = await client.post("/admin/cancel", params=query, headers=AUTH)
+        assert response.status == 200 and (await response.json())["status"] == "not_running"
+    response = await client.post("/v1/systemone", json={}, headers={**AUTH, "X-KIS-Request-ID": request_id})
+    assert response.status == 409
+    assert balancer.requests == 0 and not any(balancer.inflight.values())
+
+
+async def test_cancel_active_request_closes_backend_and_counters(server, aiohttp_server, aiohttp_client, monkeypatch):
+    balancer, cloud, began, cancelled = await slow_balancer(server, aiohttp_server, aiohttp_client, monkeypatch)
+    client = await aiohttp_client(cloud)
+    request_id = uuid.uuid4().hex
+    task = asyncio.create_task(client.post("/v1/systemone", json={}, headers={**AUTH, "X-KIS-Request-ID": request_id}))
+    await asyncio.wait_for(began.wait(), 3)
+    query = {"session": "original-session", "request_id": request_id}
+    for _ in range(2):
+        response = await client.post("/admin/cancel", params=query, headers=AUTH)
+        assert response.status == 200
+    await asyncio.wait_for(cancelled.wait(), 3)
+    await asyncio.gather(task, return_exceptions=True)
+    assert not balancer.request_tasks and balancer.waiting == 0
+    assert not any(balancer.inflight.values())
+
+
+async def test_duplicate_active_id_is_rejected(server, aiohttp_server, aiohttp_client, monkeypatch):
+    balancer, cloud, began, _ = await slow_balancer(server, aiohttp_server, aiohttp_client, monkeypatch)
+    client = await aiohttp_client(cloud)
+    request_id = uuid.uuid4().hex
+    headers = {**AUTH, "X-KIS-Request-ID": request_id}
+    task = asyncio.create_task(client.post("/v1/systemone", json={}, headers=headers))
+    await asyncio.wait_for(began.wait(), 3)
+    assert (await client.post("/v1/systemone", json={}, headers=headers)).status == 409
+    assert balancer.requests == 1
+    await client.post("/admin/cancel", params={"session": "original-session", "request_id": request_id}, headers=AUTH)
+    await asyncio.gather(task, return_exceptions=True)
+
+
+async def test_cancel_while_waiting_for_model_releases_waiting_count(aiohttp_client, balancer, monkeypatch):
+    waiting = asyncio.Event()
+
+    async def wait_for_model(_):
+        waiting.set()
+        await asyncio.Event().wait()
+
+    monkeypatch.setattr(balancer, "ensure", wait_for_model)
+    client = await aiohttp_client(balancer.app())
+    request_id = uuid.uuid4().hex
+    task = asyncio.create_task(client.post("/v1/systemone", json={}, headers={**AUTH, "X-KIS-Request-ID": request_id}))
+    await asyncio.wait_for(waiting.wait(), 3)
+    response = await client.post(
+        "/admin/cancel", params={"session": balancer.settings.session, "request_id": request_id}, headers=AUTH
+    )
+    assert response.status == 200
+    await asyncio.gather(task, return_exceptions=True)
+    assert balancer.waiting == 0 and not balancer.request_tasks
+
+
+async def test_proxy_cancels_original_session_even_after_endpoint_changes(
+    server, aiohttp_server, aiohttp_client, monkeypatch, config
+):
+    balancer, cloud, began, cancelled = await slow_balancer(server, aiohttp_server, aiohttp_client, monkeypatch)
+    url = str(cloud.make_url("")).rstrip("/")
+    current = events.Session("original-session", endpoint=url)
+    monkeypatch.setattr(events, "endpoint", lambda *_: url)
+    monkeypatch.setattr(events, "current", lambda *_: current)
+    local = await aiohttp_server(proxy.make_app(config, SECRETS))
+    async with aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=0.25)) as client:
+
+        async def send():
+            async with client.post(
+                local.make_url("/v1/systemone"), json={}, headers={"X-KIS-Request-ID": "spoof"}
+            ) as response:
+                return await response.read()
+
+        task = asyncio.create_task(send())
+        await asyncio.wait_for(began.wait(), 3)
+        current = events.Session("replacement-session", endpoint="http://127.0.0.1:1")
+        with pytest.raises(TimeoutError):
+            await task
+    await asyncio.wait_for(cancelled.wait(), 3)
+    await wait_until(lambda: not balancer.request_tasks)
+    assert balancer.waiting == 0 and not any(balancer.inflight.values())
+    assert "spoof" not in balancer.cancelled_ids
+    assert len(balancer.cancelled_ids) == 1
+
+
+async def test_retry_cleans_previous_attempt_and_uses_unique_ids(aiohttp_server, aiohttp_client, monkeypatch, config):
+    order, ids = [], []
+
+    async def decide(req):
+        order.append("infer")
+        ids.append(req.headers["X-KIS-Request-ID"])
+        if len(ids) == 1:
+            return web.Response(status=502)
+        return web.json_response({"answers": {"q": {"score": 2}}})
+
+    async def cancel(req):
+        order.append("cancel")
+        assert req.headers["Authorization"] == "Bearer secret"
+        assert req.query["session"] == "old"
+        assert req.query["request_id"] == ids[0]
+        return web.json_response({"status": "not_running"})
+
+    app = web.Application()
+    app.router.add_post("/v1/systemone", decide)
+    app.router.add_post("/admin/cancel", cancel)
+    cloud = await aiohttp_server(app)
+    url = str(cloud.make_url("")).rstrip("/")
+    monkeypatch.setattr(events, "endpoint", lambda *_: url)
+    monkeypatch.setattr(events, "current", lambda *_: events.Session("old", endpoint=url))
+    client = await aiohttp_client(proxy.make_app(config, SECRETS))
+    response = await client.post("/v1/systemone", json={})
+    assert response.status == 200 and (await response.json())["answers"]["q"]["score"] == 2
+    assert order == ["infer", "cancel", "infer"]
+    assert len(set(ids)) == 2
+
+
+async def test_unconfirmed_cancellation_blocks_duplicate_gpu_work(aiohttp_server, aiohttp_client, monkeypatch, config):
+    count = 0
+
+    async def decide(req):
+        nonlocal count
+        count += 1
+        return web.Response(status=502)
+
+    app = web.Application()
+    app.router.add_post("/v1/systemone", decide)
+    app.router.add_post("/admin/cancel", lambda _: web.Response(status=503))
+    cloud = await aiohttp_server(app)
+    url = str(cloud.make_url("")).rstrip("/")
+    monkeypatch.setattr(events, "endpoint", lambda *_: url)
+    monkeypatch.setattr(events, "current", lambda *_: events.Session("old", endpoint=url))
+    client = await aiohttp_client(proxy.make_app(config, SECRETS))
+    response = await client.post("/v1/systemone", json={})
+    assert response.status == 502
+    assert "cancellation" in (await response.json())["error"]["message"]
+    assert count == 1
